                "name": "before_id",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "https://api.moesif.com/v1/:orgId/oauth/access_tokens",
